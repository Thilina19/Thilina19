showSig=input.bool(true,"Show Signals",group=gSIG,inline="g1")
sigMinSc=input.float(60.0,"Min Level Score",minval=0,maxval=100,step=1,group=gSIG,inline="g1",tooltip=tt29+"\n\n"+tt30)
touchAtr=input.float(0.10,"Touch ATR",minval=0.0,maxval=1.0,step=0.01,group=gSIG,inline="g2")
